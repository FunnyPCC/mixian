/* pages/menu/menu.wxss */
.hd { background: linear-gradient(135deg, #ff7a3d, #ff5a2f); color: #fff; padding: 30rpx 30rpx 40rpx; }
.hd-name { font-size: 40rpx; font-weight: 700; }
.hd-notice { font-size: 24rpx; opacity: .92; margin-top: 10rpx; }
.hd-status { display: inline-block; font-size: 22rpx; border: 1rpx solid rgba(255,255,255,.6); background: rgba(255,255,255,.18); border-radius: 999rpx; padding: 4rpx 20rpx; margin-top: 16rpx; }
.hd-closed { background: rgba(0,0,0,.25); }
.tip-line { margin: 16rpx 20rpx 0; }

.cats { white-space: nowrap; padding: 20rpx 16rpx 6rpx; display: flex; }
.cats .chip { margin: 0 8rpx; }

.dish-list { padding: 10rpx 20rpx; }
.dish { display: flex; align-items: center; gap: 20rpx; background: #fff; border: 1rpx solid #eee5da; border-radius: 24rpx; padding: 22rpx; margin-bottom: 16rpx; }
.dish-out { opacity: .55; }
.d-ico { width: 104rpx; height: 104rpx; border-radius: 22rpx; background: #fff1e8; display: flex; align-items: center; justify-content: center; font-size: 56rpx; flex-shrink: 0; }
.d-mid { flex: 1; min-width: 0; }
.d-nm { font-size: 30rpx; font-weight: 600; }
.d-ds { font-size: 23rpx; color: #9b8d82; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.d-pr { font-size: 30rpx; color: #e85520; font-weight: 700; margin-top: 8rpx; }
.d-add { flex-shrink: 0; min-width: 130rpx; min-height: 76rpx; border-radius: 18rpx; background: #ff6b35; color: #fff; font-size: 25rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; padding: 0 16rpx; box-sizing: border-box; }

.bar { position: fixed; left: 0; right: 0; bottom: calc(100rpx + env(safe-area-inset-bottom)); z-index: 30; background: #2f241d; color: #fff; display: flex; align-items: center; gap: 20rpx; padding: 16rpx 24rpx; }
.cart-ico { position: relative; width: 88rpx; height: 88rpx; border-radius: 50%; background: #ff6b35; display: flex; align-items: center; justify-content: center; font-size: 40rpx; flex-shrink: 0; }
.badge { position: absolute; top: -8rpx; right: -8rpx; min-width: 34rpx; height: 34rpx; border-radius: 17rpx; background: #ffd23e; color: #5a3b00; font-size: 21rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; padding: 0 8rpx; box-sizing: border-box; }
.bar-total { font-size: 34rpx; font-weight: 700; }
.bar-sub { font-size: 21rpx; color: #cbbfb4; }
.bar-go { flex-shrink: 0; padding: 0 44rpx; min-height: 80rpx; border-radius: 999rpx; background: #ff6b35; font-weight: 700; font-size: 29rpx; display: flex; align-items: center; }
