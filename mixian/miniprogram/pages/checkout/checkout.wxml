<!-- pages/checkout/checkout.wxml -->
<view class="card">
  <view class="row" style="margin-bottom:16rpx;">
    <view class="grow" style="font-weight:700; font-size:32rpx;">送到宿舍</view>
  </view>
  <view class="field">
    <view class="field-label">送达时段</view>
    <picker mode="selector" range="{{slotLabels}}" value="{{slotIndex}}" bindchange="onSlot" disabled="{{!slots.length}}">
      <view class="input row" style="justify-content:space-between;">
        <text>{{slotLabels.length ? slotLabels[slotIndex] : '暂无可用时段'}}</text><text class="muted">▾</text>
      </view>
    </picker>
  </view>
  <view class="row" style="gap:16rpx;">
    <view class="field grow">
      <view class="field-label">楼栋（如：梅园3号楼）</view>
      <input class="input" value="{{form.dorm}}" data-f="dorm" bindinput="onInput" placeholder="宿舍楼栋" />
    </view>
    <view class="field grow">
      <view class="field-label">房间号</view>
      <input class="input" value="{{form.room}}" data-f="room" bindinput="onInput" placeholder="如 418" />
    </view>
  </view>
  <view class="row" style="gap:16rpx;">
    <view class="field grow">
      <view class="field-label">称呼</view>
      <input class="input" value="{{form.name}}" data-f="name" bindinput="onInput" placeholder="怎么称呼你" />
    </view>
    <view class="field grow">
      <view class="field-label">手机号</view>
      <input class="input" type="number" maxlength="11" value="{{form.phone}}" data-f="phone" bindinput="onInput" placeholder="11位手机号" />
    </view>
  </view>
  <view class="field">
    <view class="field-label">备注（可选）</view>
    <textarea class="input" style="min-height:120rpx;" value="{{form.note}}" data-f="note" bindinput="onInput" placeholder="例：不要葱，放宿舍门口架子" />
  </view>
</view>

<view class="card">
  <view style="font-weight:700; margin-bottom:12rpx;">已选商品</view>
  <view class="money-line" wx:for="{{cart}}" wx:key="key">
    <view class="grow" style="padding-right:16rpx;">
      {{item.emoji}} {{item.name}} ×{{item.qty}}
      <view class="muted" wx:if="{{item.spec.length}}">{{item.specText || ''}}</view>
    </view>
    <view>¥{{item.unitText}}</view>
  </view>
  <view class="money-line"><view class="grow muted">商品合计</view><view>¥{{goods}}</view></view>
  <view class="money-line"><view class="grow muted">配送费</view><view>¥{{fee}}</view></view>
  <view class="money-line money-big"><view class="grow">应付合计</view><view>¥{{total}}</view></view>
</view>

<view style="padding: 0 20rpx 60rpx;">
  <view class="err" style="margin-bottom:12rpx;">{{err}}</view>
  <button class="btn btn-pri btn-block {{submitting ? 'btn-dis' : ''}}" bindtap="submit">{{submitting ? '提交中…' : '提交订单'}}</button>
</view>
