<!-- pages/pay-qr/pay-qr.wxml -->
<view wx:if="{{order}}">
  <view class="card center">
    <view style="font-size:40rpx;">🎉</view>
    <view style="font-size:32rpx; font-weight:700; margin:8rpx 0;">下单成功，请完成付款</view>
    <view class="muted">订单号 <text style="color:#e85520; font-weight:700;">{{order.orderNo}}</text>
      <text class="copy-btn" bindtap="copyNo">复制</text>
    </view>
    <view class="money-big" style="font-size:56rpx; margin:16rpx 0;">¥{{totalText}}</view>
  </view>

  <view class="card center">
    <view style="font-weight:700; margin-bottom:8rpx;">公司收款码（微信/支付宝/云闪付均可）</view>
    <view class="muted" style="margin-bottom:16rpx;">{{order.qrTip || '扫码付款，备注里填订单号'}}</view>
    <block wx:if="{{order.qrFileid}}">
      <image src="{{order.qrFileid}}" mode="widthFix" style="width:420rpx;" bindtap="previewQr" />
      <view class="muted" style="margin-top:8rpx;">点图片可放大 · 也可保存后用微信扫一扫识别</view>
    </block>
    <view class="warn-line" wx:else>店主还未上传收款码，请联系店主，或到店付款后点「我已付款」</view>
    <view class="warn-line">⚠️ 付款时请在备注填写订单号 {{order.orderNo}}，方便店主快速对账</view>
  </view>

  <view class="card">
    <view class="row" style="justify-content:space-between;" bindtap="chooseProof">
      <view>
        <view style="font-weight:600;">上传付款凭证（可选）</view>
        <view class="muted">截图付款成功页面，店主对账更快</view>
      </view>
      <view class="btn btn-sm">{{proofLocal ? '重新上传' : '选择图片'}}</view>
    </view>
    <image wx:if="{{proofLocal}}" src="{{proofLocal}}" mode="widthFix" style="width:200rpx; margin-top:16rpx; border-radius:12rpx;" />
  </view>

  <view style="padding: 10rpx 20rpx 60rpx;">
    <button class="btn btn-pri btn-block {{submitting ? 'btn-dis' : ''}}" bindtap="markPaid">{{submitting ? '提交中…' : '我已付款，等待店主确认'}}</button>
    <button class="btn btn-block" style="margin-top:20rpx;" bindtap="goOrders">先去订单页看看</button>
  </view>
</view>
